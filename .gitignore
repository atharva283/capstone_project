# Python bytecode, packages, and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets (keep the safe example tracked)
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Runtime data: keep the folders (via .gitkeep) but never their contents
chroma_db/*
!chroma_db/.gitkeep
uploaded_documents/*
!uploaded_documents/.gitkeep
.cache/

# Test, type-checking, and coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Logs, notebooks, editors, tooling, and operating systems
*.log
.ipynb_checkpoints/
.vscode/
.idea/
.kilo/
.DS_Store
Thumbs.db

# Course-provided files (not part of the deliverable)
capstone_project.pdf
Additional instruction.txt
