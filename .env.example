# Copy to .env and replace the placeholder. Never commit your real key.
GOOGLE_API_KEY=your_gemini_api_key_here
# Optional: override the default model. If unset, blank, or a retired name, the
# app falls back to gemini-3.6-flash. gemini-1.5-* and gemini-2.5-* are retired
# for new API keys and return 404 NOT_FOUND.
GEMINI_MODEL=gemini-3.6-flash
