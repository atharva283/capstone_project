# Copy this file to a new file named ".env" and put your own keys in it.
#   Windows:    copy .env.example .env
#   Mac/Linux:  cp .env.example .env
# Never share .env or commit it to GitHub.

# Primary LLM: Google Gemini. Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
# Optional. If unset, blank, or a retired name, the app uses gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
# Optional. A second Gemini model on the same key, tried last if the main model is overloaded.
GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite

# Fallback LLM: Groq (used automatically if Gemini fails). Free key: https://console.groq.com/keys
# Optional but recommended: the app works with only one of the two keys.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
# Optional. A second Groq model on the same key, tried if the main one fails.
GROQ_BACKUP_MODEL=openai/gpt-oss-20b

# Optional. Free Gemini keys allow only a few requests per day per model. If you run out, set
# PRIMARY_LLM=groq to use Groq first (needs GROQ_API_KEY). Default: gemini.
# PRIMARY_LLM=gemini
